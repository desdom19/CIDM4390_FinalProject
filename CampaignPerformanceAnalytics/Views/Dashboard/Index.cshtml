@using CampaignPerformanceAnalytics.Services
@model DashboardResult
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
<p>Totals over every Daily Result of every Campaign and Channel.</p>

@if (Model.Failed)
{
    @* The message replaces the tiles: a failure is never shown as zeros. *@
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else
{
    // Every value shown is text from KpiFormatter, in the tile order the spec sets.
    var totals = Model.Totals;
    var tiles = new (string Label, string Value)[]
    {
        ("Total Spend", KpiFormatter.Money(totals.TotalSpend)),
        ("Total Revenue", KpiFormatter.Money(totals.TotalRevenue)),
        ("Total Leads", KpiFormatter.Count(totals.TotalLeads)),
        ("Total Impressions", KpiFormatter.Count(totals.TotalImpressions)),
        ("Total Clicks", KpiFormatter.Count(totals.TotalClicks)),
        ("Overall ROI", KpiFormatter.Roi(totals.OverallRoi)),
    };

    if (!totals.HasDailyResults)
    {
        <p class="alert alert-secondary">
            No Daily Results yet. <a asp-controller="Import" asp-action="Index">Import a CSV</a> to see your totals.
        </p>
    }

    @* Three tiles per row on a desktop, two on a tablet, one on a phone. *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var tile in tiles)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="small text-muted">@tile.Label</div>
                        <div class="fs-2 fw-semibold">@tile.Value</div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Everything drawn here comes from RoiChart; the markup only loops over its bars. *@
    var chart = RoiChart.Build(Model.ChannelTotals);

    <section class="mt-5" aria-labelledby="roi-by-channel-heading">
        <h2 id="roi-by-channel-heading" class="h4">ROI by Channel</h2>
        <ul class="list-unstyled mb-0">
            @foreach (var bar in chart.Bars)
            {
                @* Read as text, e.g. "Email 155.1%"; the bar and the zero line are hidden from screen readers. *@
                <li class="d-flex align-items-center mb-2">
                    <span class="flex-shrink-0" style="width: 5.5rem">@bar.Name</span>
                    @* RoiChart places the bar from the zero line (right for a gain, left for a loss) and its label just past the bar's far end. *@
                    <div class="flex-grow-1" style="@chart.CssTrackPadding">
                        <div class="position-relative" style="height: 1.5rem">
                            <div class="position-absolute top-0 h-100 border-start border-secondary-subtle" style="left: @chart.CssZeroLine" aria-hidden="true"></div>
                            <div class="position-absolute top-0 h-100 bg-secondary" style="@bar.CssBarStyle" aria-hidden="true"></div>
                            <span class="position-absolute top-50 translate-middle-y text-nowrap" style="@bar.CssLabelStyle">@bar.Label</span>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </section>
}
